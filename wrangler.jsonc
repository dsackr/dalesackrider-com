{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalesackrider-com",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "dalesackrider.com/*",
      "zone_name": "dalesackrider.com"
    },
    {
      "pattern": "www.dalesackrider.com/*",
      "zone_name": "dalesackrider.com"
    }
  ]
}
