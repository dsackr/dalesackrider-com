---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], readingTime } = Astro.props;
---

<BaseLayout title={`${title} — Dale Sackrider`} description={description} type="article">
  <article class="max-w-3xl mx-auto">
    <!-- Back to Articles Link -->
    <nav class="mb-8">
      <a
        href="/#articles"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline group"
      >
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to all articles
      </a>
    </nav>

    <!-- Post Header -->
    <header class="mb-10 pb-8 border-b border-zinc-200 dark:border-zinc-800">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center gap-2">
          <span>Published on</span>
          <FormattedDate date={pubDate} />
        </div>
        {readingTime && (
          <>
            <span>•</span>
            <span>{readingTime}</span>
          </>
        )}
        {updatedDate && (
          <>
            <span>•</span>
            <span>Updated on <FormattedDate date={updatedDate} /></span>
          </>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="text-xs px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Article Body -->
    <div class="prose-content">
      <slot />
    </div>

    <!-- Article Footer / Author Bio -->
    <footer class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800">
      <div class="bg-zinc-50 dark:bg-zinc-900/60 rounded-2xl p-6 sm:p-8 border border-zinc-200/80 dark:border-zinc-800">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-blue-600 text-white font-bold text-xl flex items-center justify-center shrink-0">
            DS
          </div>
          <div>
            <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
              Written by Dale Sackrider
            </h2>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
              Vice President of Cloud Engineering at Frontline Education. Writing about leadership, cloud infrastructure transformations, and systems thinking.
            </p>
            <div class="mt-3 flex items-center gap-3 text-xs font-semibold text-blue-600 dark:text-blue-400">
              <a href="/about" class="hover:underline">Read Bio →</a>
              <span>•</span>
              <a href="https://linkedin.com/in/sackrider" target="_blank" rel="noopener noreferrer" class="hover:underline">Connect on LinkedIn →</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
