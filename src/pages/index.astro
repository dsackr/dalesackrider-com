---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort descending by date
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper to calculate approximate reading time
function getReadingTime(text: string) {
  const wordsPerMinute = 200;
  const words = text.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}
---

<BaseLayout>
  <!-- Hero Section: Professional yet Personal -->
  <section class="mb-16 pt-4 sm:pt-8">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        VP of Cloud Engineering & Systems Thinker
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight leading-tight">
        Building resilient systems, leading teams, and thinking in public.
      </h1>

      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-3xl">
        I’m <strong>Dale Sackrider</strong>. I’ve spent my career working across cloud infrastructure, architecture, platform engineering, and executive leadership — with one primary focus: making complex systems work better, simpler, and easier to build upon.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="/about"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium text-sm hover:bg-zinc-800 dark:hover:bg-white transition-colors shadow-sm"
        >
          Read My Story →
        </a>
        <a
          href="https://linkedin.com/in/sackrider"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="/rss.xml"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          Subscribe via RSS
        </a>
      </div>
    </div>
  </section>

  <!-- Featured / All Articles Section -->
  <section id="articles" class="pt-8 border-t border-zinc-200 dark:border-zinc-800">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
          Essays & Articles
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          {posts.length} articles on engineering leadership, cloud strategy, and career wisdom.
        </p>
      </div>
    </div>

    <div class="space-y-8">
      {posts.map((post) => {
        const readingTime = getReadingTime(post.body || '');
        return (
          <article class="group relative flex flex-col items-start p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/50 dark:bg-zinc-900/40 hover:bg-white dark:hover:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-sm transition-all">
            <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400 mb-2">
              <FormattedDate date={post.data.pubDate} />
              <span>•</span>
              <span>{readingTime}</span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              <a href={`/posts/${post.id}`}>
                <span class="absolute inset-0 z-10"></span>
                {post.data.title}
              </a>
            </h3>

            <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>

            <div class="mt-4 flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">
              Read article <span>→</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
