---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort descending by date
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 7);
const totalPosts = sortedPosts.length;
---

<BaseLayout>
  <!-- Hero Section -->
  <Hero />

  <!-- Featured Post Section -->
  {featuredPost && (
    <section class="mb-14">
      <div class="mb-4">
        <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
          Latest Essay
        </h2>
      </div>
      <BlogCard post={featuredPost} featured={true} />
    </section>
  )}

  <!-- Recent Articles Grid Section -->
  {recentPosts.length > 0 && (
    <section id="articles" class="pt-10 border-t border-zinc-200 dark:border-zinc-800">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
            Recent Articles
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Practical insights on leadership, cloud architecture, and organizational systems.
          </p>
        </div>
        <a
          href="/archive"
          class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline"
        >
          View posts →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/archive"
          class="inline-flex items-center justify-center px-6 py-3 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 font-semibold text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all shadow-sm"
        >
          View posts →
        </a>
      </div>
    </section>
  )}
</BaseLayout>
