---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort descending by pubDate
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year
type YearGroup = {
  year: number;
  posts: typeof sortedPosts;
};

const postsByYear: YearGroup[] = [];

for (const post of sortedPosts) {
  const year = post.data.pubDate.getFullYear();
  let group = postsByYear.find((g) => g.year === year);
  if (!group) {
    group = { year, posts: [] };
    postsByYear.push(group);
  }
  group.posts.push(post);
}

// Calculate approximate reading time
function getReadingTime(text: string) {
  const wordsPerMinute = 200;
  const words = text ? text.trim().split(/\s+/).length : 0;
  const minutes = Math.max(1, Math.ceil(words / wordsPerMinute));
  return `${minutes} min read`;
}
---

<BaseLayout
  title="Archive — Dale Sackrider"
  description="Chronological archive of all articles and essays by Dale Sackrider on leadership, cloud architecture, and systems thinking."
>
  <div class="max-w-3xl mx-auto">
    <!-- Archive Header -->
    <header class="mb-12 pb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <span>Archive</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
        Article Archive
      </h1>
      <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
        A complete chronological library of {sortedPosts.length} essays, thoughts, and architectural notes.
      </p>
    </header>

    <!-- Year Groupings -->
    <div class="space-y-12">
      {postsByYear.map((group) => (
        <section class="relative">
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
              {group.year}
            </h2>
            <div class="flex-grow h-px bg-zinc-200 dark:border-zinc-800"></div>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              {group.posts.length} {group.posts.length === 1 ? 'article' : 'articles'}
            </span>
          </div>

          <div class="space-y-4">
            {group.posts.map((post) => {
              const readingTime = getReadingTime(post.body || '');
              return (
                <article class="group relative flex flex-col sm:flex-row sm:items-baseline justify-between p-4 rounded-xl border border-transparent hover:border-zinc-200 dark:hover:border-zinc-800 hover:bg-zinc-50/80 dark:hover:bg-zinc-900/60 transition-all">
                  <div class="flex-grow pr-4">
                    <h3 class="text-base sm:text-lg font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      <a href={`/posts/${post.id}/`}>
                        <span class="absolute inset-0 z-10"></span>
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-1">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="flex items-center gap-3 text-xs text-zinc-400 dark:text-zinc-500 shrink-0 mt-2 sm:mt-0">
                    <FormattedDate date={post.data.pubDate} />
                    <span>•</span>
                    <span>{readingTime}</span>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
