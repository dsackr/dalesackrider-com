---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Dale Sackrider">
  <div class="max-w-xl mx-auto text-center py-20">
    <span class="text-6xl font-black text-blue-600 dark:text-blue-400">404</span>
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-4">
      Page not found
    </h1>
    <p class="text-zinc-600 dark:text-zinc-400 mt-3 text-base">
      Sorry, the page you're looking for doesn't exist or has moved.
    </p>
    <div class="mt-8">
      <a
        href="/"
        class="inline-flex items-center px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition-colors shadow-sm"
      >
        ← Return Home
      </a>
    </div>
  </div>
</BaseLayout>
