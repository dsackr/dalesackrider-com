---
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags?: string[];
      heroImage?: string;
    };
    body?: string;
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

// Calculate approximate reading time
function getReadingTime(text: string) {
  const wordsPerMinute = 200;
  const words = text ? text.trim().split(/\s+/).length : 0;
  const minutes = Math.max(1, Math.ceil(words / wordsPerMinute));
  return `${minutes} min read`;
}

const readingTime = getReadingTime(post.body || '');
---

{featured ? (
  <article class="group relative flex flex-col p-6 sm:p-8 rounded-3xl border-2 border-blue-600/30 dark:border-blue-500/30 bg-blue-50/40 dark:bg-blue-950/20 hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-300 shadow-sm hover:shadow-md">
    <div class="flex items-center justify-between mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-600 text-white dark:bg-blue-500">
        ★ Featured Post
      </span>
      <div class="flex items-center gap-2 text-xs font-medium text-zinc-500 dark:text-zinc-400">
        <FormattedDate date={post.data.pubDate} />
        <span>•</span>
        <span>{readingTime}</span>
      </div>
    </div>

    <h3 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
      <a href={`/posts/${post.id}/`}>
        <span class="absolute inset-0 z-10"></span>
        {post.data.title}
      </a>
    </h3>

    <p class="mt-4 text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
      {post.data.description}
    </p>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-5">
        {post.data.tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-lg bg-white/80 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 font-medium border border-zinc-200/60 dark:border-zinc-700/60">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <div class="mt-6 pt-4 border-t border-blue-200/50 dark:border-blue-900/50 flex items-center justify-between text-sm font-semibold text-blue-600 dark:text-blue-400">
      <span>Read full article</span>
      <span class="group-hover:translate-x-1.5 transition-transform">→</span>
    </div>
  </article>
) : (
  <article class="group relative flex flex-col justify-between p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/40 hover:bg-white dark:hover:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-sm transition-all duration-200">
    <div>
      <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-3">
        <FormattedDate date={post.data.pubDate} />
        <span>•</span>
        <span>{readingTime}</span>
      </div>

      <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
        <a href={`/posts/${post.id}/`}>
          <span class="absolute inset-0 z-10"></span>
          {post.data.title}
        </a>
      </h3>

      <p class="mt-2.5 text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 leading-relaxed">
        {post.data.description}
      </p>
    </div>

    <div class="mt-5 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
      {post.data.tags && post.data.tags.length > 0 ? (
        <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 font-medium">
          #{post.data.tags[0]}
        </span>
      ) : (
        <span></span>
      )}
      <div class="flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">
        Read <span>→</span>
      </div>
    </div>
  </article>
)}
